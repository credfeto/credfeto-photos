#!/bin/sh

# Regenerates cloudflare-egress-ranges (next to this script) from Cloudflare's
# published address lists (https://www.cloudflare.com/ips-v4 and ips-v6). Run
# it on a workstation, not on the photos host. ./update then applies the
# new list.
#
# Cloudflare fronts Docker Hub's image CDN and other hosts, and rotates the addresses it answers with far faster than a resolved
# address list can follow, so the whole published range is allowed instead.

set -eu

SCRIPTDIR="$(dirname "$(readlink -f "$0")")"
OUT="${SCRIPTDIR}/cloudflare-egress-ranges"

{
    echo "# Cloudflare ranges from https://www.cloudflare.com/ips-v4 and ips-v6."
    echo "# Generated by firewall/update-cloudflare-egress-ranges - do not edit by hand."
    curl -fsS https://www.cloudflare.com/ips-v4
    echo
    curl -fsS https://www.cloudflare.com/ips-v6
    echo
} | grep -v '^[[:space:]]*$' > "${OUT}.tmp"
mv "${OUT}.tmp" "${OUT}"
echo "Wrote $(grep -vc '^#' "${OUT}") ranges to ${OUT}"
