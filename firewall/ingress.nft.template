# Ingress filter for the published container port. Generated by ./configure
# from ingress.nft.template - edit the template, not /etc/credfeto-photos.
#
# Docker DNATs published ports itself, and firewalld accepts all DNATed
# forwarded traffic, so this has to be a table of its own. Its forward chain
# runs before Docker's and firewalld's (priority filter - 10) and only looks
# at new DNATed connections arriving from outside the Docker bridges, matching
# the original (published) destination port. Everything else is untouched.
#
# The first two lines make loading the file replace the table atomically.
table inet pho_ingress {}
delete table inet pho_ingress

table inet pho_ingress {
    set proxies4 {
        type ipv4_addr
        elements = { @PROXIES4@ }
    }
    set proxies6 {
        type ipv6_addr
        elements = { @PROXIES6@ }
    }

    chain forward {
        type filter hook forward priority filter - 10; policy accept;
        ct state new ct status dnat iifname != "docker0" iifname != "br-*" jump published
    }

    chain published {
        # Immich (2283, as in docker-compose.yml), from the reverse proxies
        # only: the web UI and the phone apps use photos.markridgwell.com.
        meta l4proto tcp ct original proto-dst 2283 ip saddr @proxies4 accept
        meta l4proto tcp ct original proto-dst 2283 ip6 saddr @proxies6 accept
        limit rate 30/minute log prefix "pho-ingress-unmatched: " level info
        @INGRESS_ACTION@
    }
}
