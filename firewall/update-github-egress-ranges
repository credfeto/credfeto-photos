#!/bin/sh

# Regenerates github-egress-ranges (next to this script) from GitHub's
# published address list (https://api.github.com/meta: the web, git, api and
# packages ranges). Run it on a workstation, not on the photos host: the
# host's egress policy only allows GitHub itself. ./update then applies the
# new list.

set -eu

SCRIPTDIR="$(dirname "$(readlink -f "$0")")"
OUT="${SCRIPTDIR}/github-egress-ranges"

curl -fsS https://api.github.com/meta | python3 -c '
import ipaddress, json, sys
meta = json.load(sys.stdin)
nets = set()
for key in ("web", "git", "api", "packages"):
    nets.update(ipaddress.ip_network(n) for n in meta.get(key, []))
print("# GitHub web/git/api/packages ranges from https://api.github.com/meta.")
print("# Generated by firewall/update-github-egress-ranges - do not edit by hand.")
for family in (4, 6):
    for net in ipaddress.collapse_addresses(n for n in nets if n.version == family):
        print(net)
' > "${OUT}.tmp"
mv "${OUT}.tmp" "${OUT}"
echo "Wrote $(grep -vc '^#' "${OUT}") ranges to ${OUT}"
